db_username=postgres        #default user
db_password=postgres                #the password that you give postgresql when installing
db_hostname=localhost        
db_port=5432                # default port
db_name=postgres            # default db name

secret_key=your_secure_secret_key_here
algorithm=HS256             # Commonly used algorithm for JWTs
access_token_expire_minutes=90   # Token expiration time in minutes

# Default Admin Bootstrap
admin_username=your_admin_username
admin_password=your_admin_password
admin_email=your_admin_email@example.com
admin_full_name=Admin User

